---
import { Nav } from "../components/nav";
import { Showcase } from "../components/showcase";
import Layout from "../layouts/Main.astro";
import TEXT from "../TEXT";
import Footer from "../views/footer.astro";
import { Form } from "../views/form";
import { FormSwitcher } from "../views/formSwitcher";

const urls = [
  "/skill_pict.png",
  "/skill_item_01.jpg",
  "/skill_item_02.jpg",
  "/skill_item_03.jpg",
  "/skill_item_04.jpg",
  "/skill_item_05.jpg",
  "/skill_item_06.jpg",
  "/skill_item_07.jpg",
  "/skill_item_08.jpg",
  "/skill_item_09.jpg",
  "/skill_item_10.jpg",
  "/skill_item_11.jpg",
  "/skill_item_12.jpg",
  "/skill_item_13.jpg",
  "/skill_item_14.jpg",
  "/skill_item_15.jpg",
];
---

<Layout title={TEXT.layoutTitle}>
  <div class="wrapper">
    <Nav client:only="react" />
    <div class="home">
      <header id="header">
        <div class="container">
          <div class="header__wrap">
            <img src="/header_photo.png" alt={TEXT.alts.main} />
            <h3 class="header__title">
              {TEXT.header.familyName}<br />{TEXT.header.nameMiddleName}
            </h3>
            <h1 class="header__over-title">{TEXT.header.title}</h1>
            <h2 class="header__headline">{TEXT.header.subtext}</h2>
            <FormSwitcher client:only="react" />
          </div>
        </div>
      </header>
      <section id="skill" class="skill">
        <div class="container">
          <div class="skill__wrap">
            <h2 class="title">{TEXT.skill.title}</h2>
            <h3 class="skill__subtitle">{TEXT.skill.subtitle}</h3>
            <p class="skill__text">{TEXT.skill.text_01}</p>
            <p class="skill__text">{TEXT.skill.text_02}</p>
            <FormSwitcher client:only="react" />
          </div>
          <Showcase urls={urls} client:only="react" />
        </div>
      </section>
      <section id="quote" class="quote">
        <div class="container">
          <h2 class="title">{TEXT.quote.title}</h2>
          <div class="quote__case">
            <div class="quote__cell">
              <p class="quote__text">{TEXT.quote.text}</p>
              <img src="/icon_quotes.svg" class="quote__decore" />
            </div>
            <div class="quote__cell">
              <img
                src="/quote_photo.jpg"
                alt={TEXT.alts.main}
                class="quote__photo"
              />
            </div>
          </div>
          <a href="/services" class="button">{TEXT.serviceLink}</a>
        </div>
      </section>
      <Form client:only="react" />
    </div>
    <Footer />
  </div>
</Layout>
